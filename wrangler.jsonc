// Cloudflare deployment of the pipeline. Everything the Deploy to Cloudflare button needs lives
// here so one click can provision the container, the R2 bucket and the Workflow.
// Docs: https://developers.cloudflare.com/containers/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-daily-podcast",
  "main": "deploy/cloudflare/src/index.ts",
  "compatibility_date": "2026-11-26",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  // One episode a day. Change it to whatever your audience expects; times are UTC.
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "vars": {
    // The routing model that serves every stage. Point its targets at non-reasoning models
    // (qwen-flash, claude-haiku) or the run dies with 502 — see the README.
    "AIXY_MODEL": "aixy/podcast-agent",
    "PODCAST_NAME": "AI Daily Podcast",
    "CONTAINER_INSTANCE": "basic",
    // "tinyfish", "exa", … leave empty to let Aixy's discovery choose the connected connector.
    "AIXY_WEB_PROVIDER": "",
    "AIXY_TTS_PROVIDER": "elevenlabs"
  },
  "containers": [
    {
      "class_name": "PodcastContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./deploy/cloudflare/container/Dockerfile",
          // The image installs this repository, so it builds from the repository root.
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PODCAST_CONTAINER",
        "class_name": "PodcastContainer"
      }
    ]
  },
  "workflows": [
    {
      "name": "episode-workflow",
      "binding": "EPISODE_WORKFLOW",
      "class_name": "EpisodeWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EPISODES",
      "bucket_name": "ai-daily-podcast-episodes"
    }
  ],
  "exports": {
    "PodcastContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}