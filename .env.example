# Copy to .env and fill in. Never commit .env.

# Aixy project key: owns the routing model (aixy/podcast-agent). Required.
AIXY_API_KEY=

# Aixy personal MCP token (Agents → MCP tools → API keys). Required.
AIXY_MCP_TOKEN=

# Optional overrides
# AIXY_MODEL=aixy/podcast-agent
# AIXY_BASE_URL=https://api.aixy-gateway.com/v1
# AIXY_MCP_URL=https://api.aixy-gateway.com/mcp

# ElevenLabs voice. Leave empty and an agent picks a Spanish voice through Aixy.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v3
# TTS_CHUNK_CHARS=4500

# Show and pipeline
# PODCAST_NAME=AI Daily Podcast
# PODCAST_SOURCES=sources.toml
# PODCAST_OUTPUT_DIR=out
# PODCAST_CONCURRENCY=5
# TOOL_RESULT_MAX_CHARS=40000
